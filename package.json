{
  "name": "develop-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 -p 7000",
    "build": "prisma generate && node node_modules/velite/bin/velite.js build && next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "docker:build": "docker build -t develop-blog .",
    "docker:run": "docker run -p 8080:8080 --env-file .env develop-blog",
    "deploy": "bash scripts/deploy-cloud-run.sh"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@side/db": "workspace:*",
    "@side/ui": "workspace:*",
    "@side/utils": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "next": "16.0.10",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.20.0",
    "velite": "^0.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "turbo": "latest",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
